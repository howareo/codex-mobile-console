{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/server",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/protocol/**/*.ts", "src/probe/**/*.ts", "src/server/**/*.ts", "src/shared/**/*.ts"]
}
